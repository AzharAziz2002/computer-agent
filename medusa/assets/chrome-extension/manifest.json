{
  "manifest_version": 3,
  "name": "Medusa Browser Relay",
  "version": "0.1.0",
  "description": "Lets Medusa open and control its own tabs in your browser, using your saved logins and cookies.",
  "permissions": ["debugger", "tabs", "activeTab", "tabGroups", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Medusa Browser Relay"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
